# Fire App Supabase Configuration
# Create a separate Supabase project for the fire app
# Copy this file to .env.local and fill in your values

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=your_fire_project_url_here

# Supabase Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_fire_project_anon_key_here
